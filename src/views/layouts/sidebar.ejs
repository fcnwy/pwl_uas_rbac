<aside class="w-64 bg-gray-900 text-white min-h-screen flex flex-col">
  <div class="p-5 text-xl font-bold border-b border-gray-700">🔐 RBAC System</div>
  <nav class="flex-1 p-2">
    <% if (typeof permissions !== 'undefined' && permissions.includes('user:view')) { %>
    <a href="/users" class="flex items-center gap-2 p-3 rounded hover:bg-gray-700 transition">👥 Users</a>
    <% } %>
    <% if (typeof permissions !== 'undefined' && permissions.includes('role:view')) { %>
    <a href="/roles" class="flex items-center gap-2 p-3 rounded hover:bg-gray-700 transition">🏷️ Roles</a>
    <% } %>
    <% if (typeof permissions !== 'undefined' && permissions.includes('perm:view')) { %>
    <a href="/permissions" class="flex items-center gap-2 p-3 rounded hover:bg-gray-700 transition">🔑 Permissions</a>
    <% } %>
  </nav>
  <div class="p-4 border-t border-gray-700">
    <a href="/auth/logout" class="block text-center bg-red-600 hover:bg-red-700 rounded p-2 text-sm">Logout</a>
  </div>
</aside>
