<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | RBAC</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="flex min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 flex flex-col">
    <%- include('../layouts/header') %>
    <main class="p-6 flex-1">
      <div class="bg-white rounded-xl shadow p-6 max-w-lg">
        <form method="POST" action="/roles">
          <div class="mb-4">
            <label class="block text-sm font-medium mb-1">Nama Role</label>
            <input type="text" name="name" required placeholder="contoh: manager"
              class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          </div>
          <div class="flex gap-3">
            <button type="submit"
              class="bg-blue-600 text-white px-5 py-2 rounded hover:bg-blue-700">Simpan</button>
            <a href="/roles"
              class="bg-gray-200 text-gray-700 px-5 py-2 rounded hover:bg-gray-300">Batal</a>
          </div>
        </form>
      </div>
    </main>
    <%- include('../layouts/footer') %>
  </div>
</div>
</body>
</html>
