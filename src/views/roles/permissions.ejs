<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | RBAC</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="flex min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 flex flex-col">
    <%- include('../layouts/header') %>
    <main class="p-6 flex-1">
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-semibold mb-4">Assign Permission ke Role</h2>
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-gray-100">
              <th class="border p-3 text-left">Permission</th>
              <th class="border p-3 text-left">Resource</th>
              <th class="border p-3 text-left">Action</th>
              <th class="border p-3 text-left">Status</th>
            </tr>
          </thead>
          <tbody>
            <% allPerms.forEach(p => { %>
            <tr class="hover:bg-gray-50">
              <td class="border p-3"><code class="bg-gray-100 px-1 rounded"><%= p.name %></code></td>
              <td class="border p-3"><%= p.resource %></td>
              <td class="border p-3"><%= p.action %></td>
              <td class="border p-3">
                <% if (rolePermIds.includes(p.id)) { %>
                <form method="POST" action="/roles/<%= roleId %>/permissions/<%= p.id %>/delete">
                  <button class="bg-red-500 text-white px-3 py-1 rounded text-xs hover:bg-red-600">Cabut</button>
                </form>
                <% } else { %>
                <form method="POST" action="/roles/<%= roleId %>/permissions">
                  <input type="hidden" name="permission_id" value="<%= p.id %>">
                  <button class="bg-green-500 text-white px-3 py-1 rounded text-xs hover:bg-green-600">Assign</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <a href="/roles" class="inline-block mt-4 bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300 text-sm">← Kembali</a>
      </div>
    </main>
    <%- include('../layouts/footer') %>
  </div>
</div>
</body>
</html>
