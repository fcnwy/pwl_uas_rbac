<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | RBAC</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="flex min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 flex flex-col">
    <%- include('../layouts/header') %>
    <main class="p-6 flex-1">
      <div class="bg-white rounded-xl shadow p-6 max-w-lg">
        <% if (error) { %>
        <div class="bg-red-100 text-red-700 rounded p-3 mb-4 text-sm"><%= error %></div>
        <% } %>
        <form method="POST" action="/users">
          <div class="mb-4">
            <label class="block text-sm font-medium mb-1">Username</label>
            <input type="text" name="username" required
              class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium mb-1">Password</label>
            <input type="password" name="password" required
              class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          </div>
          <div class="mb-6">
            <label class="block text-sm font-medium mb-1">Role</label>
            <select name="role_id" required
              class="w-full border rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
              <% roles.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="flex gap-3">
            <button type="submit"
              class="bg-blue-600 text-white px-5 py-2 rounded hover:bg-blue-700">Simpan</button>
            <a href="/users"
              class="bg-gray-200 text-gray-700 px-5 py-2 rounded hover:bg-gray-300">Batal</a>
          </div>
        </form>
      </div>
    </main>
    <%- include('../layouts/footer') %>
  </div>
</div>
</body>
</html>
