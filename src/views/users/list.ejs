<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | RBAC</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="flex min-h-screen">
  <%- include('../layouts/sidebar') %>
  <div class="flex-1 flex flex-col">
    <%- include('../layouts/header') %>
    <main class="p-6 flex-1">
      <div class="bg-white rounded-xl shadow p-6">
        <div class="flex justify-between items-center mb-5">
          <h2 class="text-lg font-semibold">Daftar User</h2>
          <% if (permissions.includes('user:create')) { %>
          <a href="/users/create" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-sm">+ Tambah User</a>
          <% } %>
        </div>
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-gray-100">
              <th class="border p-3 text-left">#</th>
              <th class="border p-3 text-left">Username</th>
              <th class="border p-3 text-left">Role</th>
              <th class="border p-3 text-left">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((u, i) => { %>
            <tr class="hover:bg-gray-50">
              <td class="border p-3"><%= i+1 %></td>
              <td class="border p-3"><%= u.username %></td>
              <td class="border p-3">
                <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs"><%= u.role_name || '-' %></span>
              </td>
              <td class="border p-3">
                <div class="flex gap-2">
                  <% if (permissions.includes('user:edit')) { %>
                  <a href="/users/<%= u.id %>/edit" class="bg-yellow-500 text-white px-3 py-1 rounded text-xs hover:bg-yellow-600">Edit</a>
                  <% } %>
                  <% if (permissions.includes('user:delete')) { %>
                  <form method="POST" action="/users/<%= u.id %>/delete" onsubmit="return confirm('Hapus user ini?')">
                    <button class="bg-red-500 text-white px-3 py-1 rounded text-xs hover:bg-red-600">Hapus</button>
                  </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
    <%- include('../layouts/footer') %>
  </div>
</div>
</body>
</html>
